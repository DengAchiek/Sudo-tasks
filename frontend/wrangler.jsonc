{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roadlens-nairobi",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roadlens-auth",
      "database_id": "cb8139c8-7f8f-455f-a888-cb55ca556c6d",
      "migrations_dir": "./migrations"
    }
  ]
}
